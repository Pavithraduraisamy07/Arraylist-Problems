import java.util.*;
public class Main{
public static void main(String[] args){
ArrayList<Integer> list = new ArrayList<>();

list.add(10);
list.add(20);
list.add(10);
list.add(30);
list.add(20);
list.add(40);
list.add(10);
list.add(50);

int maxCount = 0;
int answer = 0;

for(int i = 0; i < list.size(); i++) {

    int count = 0;

    for(int j = 0; j < list.size(); j++) {

        if(list.get(i).equals(list.get(j))) {
            count++;
        }
    }

    if(count > maxCount) {
        maxCount = count;
        answer = list.get(i);
    }
}

System.out.print(answer);
}
}
